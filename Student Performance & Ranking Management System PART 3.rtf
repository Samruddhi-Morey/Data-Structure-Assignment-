\f0\fs24 \cf0 #include <iostream> \
using namespace std; \
\
int main() \
\{ \
    int marks[5]; \
\
    cout << "Enter marks of 5 students:\\n"; \
\
    for (int i = 0; i < 5; i++) \
    \{ \
        cin >> marks[i]; \
    \} \
\
    // Sorting in descending order \
    for (int i = 0; i < 4; i++) \
    \{ \
        for (int j = 0; j < 4 - i; j++) \
        \{ \
            if (marks[j] < marks[j + 1]) \
            \{ \
                int temp = marks[j]; \
\
                marks[j] = marks[j + 1]; \
\
                marks[j + 1] = temp; \
            \} \
        \} \
    \} \
\
    cout << "\\nStudent Ranking based on Marks:\\n"; \
\
    for (int i = 0; i < 5; i++) \
    \{ \
        cout << marks[i] << endl; \
    \} \
\
    return 0; \
\}}